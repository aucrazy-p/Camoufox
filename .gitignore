# 指纹环境管理器 —— 只把源码与构建脚本放进来
# 仓库是公开的：任何账号数据、cookie、内核、令牌、本机探测产物都不得入库。

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ── 内嵌 Python 运行时 / 打包中间产物（数百 MB，CI 用 prepare_runtime.py 重建）──
/runtime/
/_tools/stage/
/_tools/pyi-work/
/_tools/build/
/_tools/dist/
/_tools/*.spec
/dist/
/_MEI*/
/build/
*.zip
*.7z
*.part

# ── 账号数据与本机运行数据（绝对不入库）──
/data/
/CamoufoxData/
/_dl/
/_trim/
/_dev/
/_tools/fresh_data/
/_tools/fresh_data2/
/_tools/fresh_ui/
/_tools/portable_probe/
/_tools/fp_audit/
/_tools/probe_run/
/_tools/probe_work/
/_tools/probe_dist/
/_tools/probe_spec/
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite-journal
cookies.sqlite*
logins.json
key4.db
sessionstore*
parent.lock
.pid
host_gpu.json
runtime.json
settings.json
fingerprint.json
network.json
config.json

# 注意：app/requirements.txt 与 resources/*.txt 需要保留，不能全局忽略 *.txt

# ── 日志、截图、一次性探测输出 ──
*.log
*.bmp
/_tools/*.png
/_tools/*.txt
/_tools/*.pid
/_tools/7z*/
/_tools/7z*.7z
/_tools/icons/
/_tools/hello.py
/_tools/hello.spec
/_tools/fetch_7z.py
/_tools/fp_audit.py
/_tools/probe_*.py
/_tools/test_sfx.py

# ── 编辑器 / 系统 ──
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
